-    :cond_2
-    const/4 p2, 0x0
-
-    invoke-virtual {p0, p1, p2, p2, p2}, Lcom/android/server/lights/LightsService$LightImpl;->setLightLocked(IIII)V
+    invoke-virtual {p0, p3}, Lcom/android/server/lights/LightsService$LightImpl;->r8sSetLegacyBrightnessLocked(F)V
 
