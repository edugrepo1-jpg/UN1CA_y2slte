-    move-result p1
-
-    const/16 p2, 0xff
-
-    if-gt p1, p2, :cond_2
-
-    and-int/lit16 p1, p1, 0xff
-
-    shl-int/lit8 p2, p1, 0x10
-
-    const/high16 p3, -0x1000000
-
-    or-int/2addr p2, p3
-
-    shl-int/lit8 p3, p1, 0x8
-
-    or-int/2addr p2, p3
-
-    or-int/2addr p1, p2
